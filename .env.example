# API (Railway)
PORT=3001
FRONTEND_ORIGIN=https://your-frontend-domain.example

# Frontend (같은 서버에서 정적 파일을 같이 쓰거나, API만 분리할 때)
# VITE_API_URL=https://your-api.up.railway.app

# --- Blizzard OAuth (develop.battle.net 에서 앱 생성 후 발급) ---
# 로그인 리전: us / eu / kr / tw / cn (기본값 kr)
BLIZZARD_REGION=kr
BLIZZARD_CLIENT_ID=your-client-id
BLIZZARD_CLIENT_SECRET=your-client-secret
# Blizzard 앱에 등록한 Redirect URL 과 정확히 일치해야 합니다.
# 개발: http://localhost:3001/api/auth/blizzard/callback
# 배포: https://your-domain/api/auth/blizzard/callback
BLIZZARD_REDIRECT_URI=http://localhost:3001/api/auth/blizzard/callback
